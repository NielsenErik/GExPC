{
    "mlflow": null,
    "experiment": "crack_segmentation",
    "algorithm": "pcnet_ge",
    "device": "cpu",
    "n_cpus": 20,

    "data_path": "data/GAPS384/train",
    "test_path": "data/GAPS384/test",
    "save_path": "models/",
    "validation_split": 0.2,

    "preprocessing": false,

    "epochs": 60,
    "batch_size": 32,
    "resize_size": [
        256,
        256
    ],
    "input_channels": 3,
    "n_classes": 1,
    "max_depth": 8,
    "max_branching": 3,
    "seed": 90,
    "filter_sizes": [15, 21],
    "n_cv_modules": 20,
    "n_filters": 100,

    "ge":{
        "generations": 10,
        "pop_size": 20,
        "genome_len": 96,
        "crossover_rate": 0.9,
        "mutation_rate": 0.05,
        "elite_k": 2,
        "train_split": 0.1
    },

    "execution_mode": "train"
    

}
